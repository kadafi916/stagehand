# Copy this to .env (which is gitignored) and fill in your actual paths/port.
# Used by docker-compose.yml.

CONTAINER_NAME=stagehand
HOST_PORT=8088
CONFIG_DIR=~/.config/stagehand
TV_DIR=/path/to/tv
MEM_LIMIT=512M
# Relative CPU priority (default weight is 1024); not a hard cap, see
# docker-compose.yml for why.
CPU_SHARES=512
